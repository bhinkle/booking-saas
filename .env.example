# Supply these through the PHP server environment; this file is not auto-loaded.
APP_ENV=local
DB_DSN=mysql:host=localhost;port=3306;dbname=hinklema_booking;charset=utf8mb4
DB_USER=bhinkle
# Dummy placeholder only. Replace privately on the server before connecting.
DB_PASSWORD=password
# Generate with PHP password_hash(); never use a plaintext password here.
OWNER_EMAIL=owner@example.test
OWNER_PASSWORD_HASH=replace-with-generated-password-hash
# HTTPS deployment requires secure session cookies; HTTP local testing uses 0.
SESSION_SECURE=0

# Platform subscription billing only; never use tenant rental gateway keys.
NMI_SANDBOX_ENABLED=0
NMI_SECURITY_KEY=
NMI_TOKENIZATION_KEY=
