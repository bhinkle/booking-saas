# Supply these through the PHP server environment; this file is not auto-loaded.
APP_ENV=local
DB_DSN=mysql:host=127.0.0.1;port=3306;dbname=booking_saas;charset=utf8mb4
DB_USER=booking_app
DB_PASSWORD=replace-with-local-password
# Generate with PHP password_hash(); never use a plaintext password here.
OWNER_EMAIL=owner@example.test
OWNER_PASSWORD_HASH=replace-with-generated-password-hash
# HTTPS deployment requires secure session cookies; HTTP local testing uses 0.
SESSION_SECURE=0
